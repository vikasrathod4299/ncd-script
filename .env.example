# Telegram bot
TELEGRAM_BOT_TOKEN="123456:replace-me"
# Admins can always use the bot.
ADMIN_TELEGRAM_IDS="123456789"
# Other users allowed to use the bot in private. Admins are always allowed.
# Leave empty to allow admins only.
ALLOWED_TELEGRAM_IDS=""

# Storage
DATA_DIR="./data"
# APP_SECRET_KEY="optional-long-random-string"
# APP_SECRET_KEY_FILE="./data/secret.key"

# Portal
NCD_BASE_URL="https://ncd.mohfw.gov.in"
NCD_BASIC_AUTH="TkNEQnJvd3NlcjpTZWN1cmVOQ0Q="
# Match the portal frontend: double base64 (default). Use single only if login fails.
NCD_LOGIN_PASSWORD_ENCODING="double"

# Runtime
NCD_CONCURRENCY=3
NCD_DRY_RUN=0
TOKEN_REFRESH_INTERVAL_MS=1800000
TOKEN_REFRESH_SKEW_MS=1200000
# Set to 1 to validate the refresh token before each job starts.
# Detects an account logged in elsewhere before the job begins.
NCD_FORCE_REFRESH_ON_JOB_START=0
PROGRESS_INTERVAL_MS=15000
MAX_CAPTCHA_ATTEMPTS=3
CAPTCHA_REPLY_TIMEOUT_MS=120000
MAX_DOWNLOAD_BYTES=20971520
LOG_LEVEL=info
